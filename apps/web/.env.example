# Environment variables example
# Copy this file to .env.local and update the values as needed

# Node
NODE_ENV=development

# Public site URL (desktop AI + packaged Electron use port 3045)
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3045

# Optional — leave blank to disable Freesound search in the Sounds panel
FREESOUND_CLIENT_ID=
FREESOUND_API_KEY=

# Mangocut AI — OpenRouter proxy (required for desktop AI chat)
OPENROUTER_API_KEY=
# Optional comma-separated allowlist; empty allows curated defaults
OPENROUTER_ALLOWED_MODELS=
# Optional dedicated vision model allowlist falls back to OPENROUTER_ALLOWED_MODELS

# Auth / free trial (Better Auth + Google)
BETTER_AUTH_SECRET=
# Must match the desktop/web origin used for Google OAuth redirects
# Dev AI + packaged Electron both default to http://127.0.0.1:3045
BETTER_AUTH_URL=http://127.0.0.1:3045
# From Better Auth Infrastructure dashboard project
BETTER_AUTH_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Web client authorized redirect URI (required):
#   http://127.0.0.1:3045/api/auth/callback/google
# Authorized JavaScript origin:
#   http://127.0.0.1:3045

# Free AI trial — no payment. AI stops when either limit is hit.
# Turn budget per signed-in account (each OpenRouter chat/vision call counts)
AI_TRIAL_CHAT_TURNS=50
# Optional USD spend cap from OpenRouter usage.cost (empty = turns-only)
AI_TRIAL_SPEND_USD=
# Agent tool-loop budget (default 24)
AI_AGENT_MAX_STEPS=24
# When false, unsigned callers can use /api/ai/* (local break-glass only).
# Default: sign-in required for AI.
AI_REQUIRE_AUTH=true
# SQLite + usage JSON directory (defaults to apps/web/.data)
MANGOCUT_DATA_DIR=

# Optional — local agent tracing into self-hosted Langfuse (observability/README.md).
# `bun run observability:setup` fills these in. Leave blank to disable tracing
# (production/Vercel has none, so nothing is sent).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# Production / packaged desktop: point AI + auth at the hosted Mangocut.
# Leave empty for local-only `bun run dev:ai`.
NEXT_PUBLIC_MANGOCUT_CLOUD_ORIGIN=
MANGOCUT_CLOUD_ORIGIN=
# Admin dashboard (/admin) — exact email match (case-insensitive)
MANGOCUT_ADMIN_EMAIL=manoj.elango123@gmail.com
NEXT_PUBLIC_MANGOCUT_ADMIN_EMAIL=manoj.elango123@gmail.com
