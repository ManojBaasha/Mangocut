{
  "name": "mangocut",
  "packageManager": "bun@1.2.18",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build rust/wasm --target bundler --out-dir pkg",
    "build:web": "turbo run build --filter=@mangocut/web",
    "build:web:electron": "NEXT_PUBLIC_SITE_URL=http://127.0.0.1:47823 MANGOCUT_DESKTOP=1 turbo run build --filter=@mangocut/web --force",
    "prepare:electron": "bun run --cwd apps/electron prepare:standalone",
    "build:electron": "bun run build:web:electron && bun run prepare:electron && bun run --cwd apps/electron dist:mac",
    "dev:electron": "bun run --cwd apps/electron dev",
    "dev:wasm": "cargo watch -w rust/crates -w rust/wasm/src -s 'wasm-pack build rust/wasm --target bundler --out-dir pkg'",
    "dev:web": "turbo run dev --filter=@mangocut/web",
    "format:web": "biome format apps/web/src/services/renderer --write --max-diagnostics=1000",
    "generate:fonts": "npx tsx apps/web/scripts/generate-font-sprites.ts",
    "lint:web": "biome lint apps/web/src --max-diagnostics=1000",
    "lint:web:fix": "biome lint apps/web/src --write --unsafe --max-diagnostics=1000",
    "publish:wasm": "bun run build:wasm && npm publish rust/wasm/pkg --access public",
    "test": "bun test"
  },
  "dependencies": {
    "@biomejs/biome": "^2.4.8",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "next": "^16.1.3"
  },
  "devDependencies": {
    "turbo": "^2.8.20",
    "typescript": "^6.0.2"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "electron",
    "electron-winstaller",
    "esbuild",
    "onnxruntime-node",
    "protobufjs",
    "sharp"
  ]
}
